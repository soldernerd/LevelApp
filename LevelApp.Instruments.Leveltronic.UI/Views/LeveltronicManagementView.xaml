<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LevelApp.Instruments.Leveltronic.UI.Views.LeveltronicManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LevelApp.Instruments.Leveltronic.UI.ViewModels"
    xmlns:conv="using:LevelApp.Instruments.Leveltronic.UI.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>

        <!-- One Settings / Calibrations value: label, description, device value, editor, read / write -->
        <DataTemplate x:Key="ValueRowTemplate" x:DataType="vm:ValueRowViewModel">
            <Grid Padding="0,6" ColumnSpacing="12"
                  Visibility="{x:Bind IsAvailable, Mode=OneWay, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}"/>
                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind RangeText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalTextAlignment="Right"
                           Text="{x:Bind DeviceValueText, Mode=OneWay}"/>

                <NumberBox Grid.Column="2" VerticalAlignment="Center"
                           Value="{x:Bind EditValue, Mode=TwoWay}"
                           Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}"
                           SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10"
                           ValidationMode="InvalidInputOverwritten"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="Read" Command="{x:Bind ReadCommand}"/>
                    <Button Content="Write" Command="{x:Bind WriteCommand}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueGroupTemplate" x:DataType="vm:ValueGroup">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="InfoRowTemplate" x:DataType="vm:InfoRow">
            <Grid Padding="0,2" ColumnDefinitions="260,*">
                <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" IsTextSelectionEnabled="True"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InfoGroupTemplate" x:DataType="vm:InfoGroup">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActionTemplate" x:DataType="vm:ActionItem">
            <Grid Padding="0,6" ColumnSpacing="12" ColumnDefinitions="200,*">
                <Button Grid.Column="0" Content="{x:Bind Label}" Command="{x:Bind Command}" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Subtitle}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="4" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Connection bar -->
        <Grid Grid.Row="0" ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                       Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}"/>
            <Button Grid.Column="1" Content="Connect" Command="{x:Bind ViewModel.ConnectCommand}"/>
            <Button Grid.Column="2" Content="Read all values" Command="{x:Bind ViewModel.RefreshAllValuesCommand}"/>
            <Button Grid.Column="3" Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"/>
        </Grid>

        <!-- Service mode card -->
        <Border Grid.Row="1" CornerRadius="6" Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource Vis}}">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.ServiceTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.ServiceText, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <HyperlinkButton Content="Leave service mode" Padding="0"
                                 Command="{x:Bind ViewModel.LeaveServiceModeCommand}"
                                 Visibility="{x:Bind ViewModel.ServiceMode, Mode=OneWay, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Border>

        <Pivot Grid.Row="2" x:Name="Tabs" SelectionChanged="OnTabChanged">
            <PivotItem x:Name="LiveTab" Header="Live" Tag="live"/>

            <PivotItem Header="Info" Tag="info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.InfoGroups}"
                                      ItemTemplate="{StaticResource InfoGroupTemplate}"/>
                        <Button Content="Set instrument clock to PC time"
                                Command="{x:Bind ViewModel.SetClockToPcCommand}" Margin="0,4,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Settings" Tag="settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SettingGroups}"
                                  ItemTemplate="{StaticResource ValueGroupTemplate}"/>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Actions" Tag="actions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Actions}"
                                  ItemTemplate="{StaticResource ActionTemplate}"/>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Calibration values" Tag="calibration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CalibrationGroups}"
                                  ItemTemplate="{StaticResource ValueGroupTemplate}"/>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="ScopeTab" Header="Oscilloscope" Tag="scope"/>

            <PivotItem x:Name="DiagnosticsTab" Header="Diagnostics" Tag="diagnostics"/>
        </Pivot>

        <!-- Status -->
        <Grid Grid.Row="3" ColumnSpacing="8" ColumnDefinitions="Auto,*">
            <ProgressRing Grid.Column="0" Width="16" Height="16"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.StatusIsError, Mode=OneWay, Converter={StaticResource Vis}, ConverterParameter=invert}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.StatusIsError, Mode=OneWay, Converter={StaticResource Vis}}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Grid>
    </Grid>
</UserControl>
