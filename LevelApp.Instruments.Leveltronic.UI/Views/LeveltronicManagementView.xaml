<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LevelApp.Instruments.Leveltronic.UI.Views.LeveltronicManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LevelApp.Instruments.Leveltronic.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="SettingRowTemplate" x:DataType="vm:LeveltronicSettingRow">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Field}" />
                    <TextBlock Text="{x:Bind Group}" FontSize="11" Opacity="0.6" />
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           HorizontalTextAlignment="Right"
                           Text="{x:Bind DeviceValueText, Mode=OneWay}" />

                <NumberBox Grid.Column="2"
                           Value="{x:Bind EditValue, Mode=TwoWay}"
                           Minimum="{x:Bind Minimum}"
                           Maximum="{x:Bind Maximum}"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="1" LargeChange="10"
                           ValidationMode="InvalidInputOverwritten" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <Button Content="Read"
                            Command="{Binding DataContext.ReadSettingCommand, ElementName=Root}"
                            CommandParameter="{x:Bind}" />
                    <Button Content="Write"
                            Command="{Binding DataContext.WriteSettingCommand, ElementName=Root}"
                            CommandParameter="{x:Bind}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="4" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding DeviceName}" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Connect" Command="{Binding ConnectCommand}" />
            <Button Grid.Column="2" Content="Disconnect" Command="{Binding DisconnectCommand}"
                    IsEnabled="{Binding IsConnected}" />
        </Grid>

        <!-- Identity / state / RTC -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{Binding IdentityText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeviceStateText}" TextWrapping="Wrap" Opacity="0.8" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="RTC:" Opacity="0.8" />
                <TextBlock VerticalAlignment="Center" Text="{Binding RtcText}" />
                <Button Content="Set to PC clock" Command="{Binding SetRtcToNowCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Read all" Command="{Binding RefreshAllCommand}" />
            <Button Content="Write changed" Command="{Binding WriteAllChangedCommand}" />
            <Button Content="Test beep" Command="{Binding TestBeepCommand}" />
            <Button Content="Force charge" Command="{Binding ForceChargeCommand}" />
            <Button Content="Reboot to DFU…" Command="{Binding RebootToDfuCommand}" />
        </StackPanel>

        <!-- Settings list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Settings}"
                          ItemTemplate="{StaticResource SettingRowTemplate}" />
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" IsActive="{Binding IsBusy}" Width="16" Height="16" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.9" />
        </Grid>
    </Grid>
</UserControl>
