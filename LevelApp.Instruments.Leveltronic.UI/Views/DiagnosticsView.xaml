<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LevelApp.Instruments.Leveltronic.UI.Views.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LevelApp.Instruments.Leveltronic.UI.ViewModels"
    xmlns:conv="using:LevelApp.Instruments.Leveltronic.UI.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>

        <!-- One converter channel: name, ADC input, PGA, RMS bar, RMS / peak-peak / phase, calibrated phase -->
        <DataTemplate x:Key="ChannelCardTemplate" x:DataType="vm:SignalChannelCard">
            <Border Margin="0,0,0,10" Padding="14" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8" ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind AdcText}" VerticalAlignment="Bottom"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind PgaText, Mode=OneWay}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind RmsFraction, Mode=OneWay}"/>

                    <Grid ColumnSpacing="12" ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RMS" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind RmsText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PEAK–PEAK" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind P2pText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PHASE" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind PhaseText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{x:Bind HasCalibratedPhase, Mode=OneWay, Converter={StaticResource Vis}}">
                        <TextBlock Text="CALIBRATED PHASE" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind CalibratedPhaseText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One line of the noise table: sigma, peak-peak, quadrature, step / floor with verdict -->
        <DataTemplate x:Key="NoiseRowTemplate" x:DataType="vm:NoiseRow">
            <Grid Padding="0,6" ColumnSpacing="8" ColumnDefinitions="1.5*,*,*,*,1.2*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind FloorText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind SigmaText, Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind P2pText, Mode=OneWay}"/>
                <TextBlock Grid.Column="3" Text="{x:Bind QuadText, Mode=OneWay}"/>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{x:Bind RatioText, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind VerdictText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind IsDoubtful, Mode=OneWay, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <TextBlock Text="{x:Bind VerdictText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{x:Bind IsDoubtful, Mode=OneWay, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="4" Spacing="8">
            <TextBlock TextWrapping="Wrap" LineHeight="20"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Channels A, B, S1, S2, with the ADC input each is wired to (A = ch2, B = ch1, S1 = ch3, S2 = ch0) and its PGA gain. A and B are the excitation references; S1 and S2 are the sensor signals. Phase is referenced so that A sits at about 90° and B at about 270°. The calibrated phase of S1 and S2 is the measured phase less the stored phase: it follows A (90°) for a positive tilt and B (270°) for a negative one. The drive to the sensor is A − B, about 2 × A. For setting up and troubleshooting, not for measuring."/>

            <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource Vis}, ConverterParameter=invert}"/>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Channels}"
                          ItemTemplate="{StaticResource ChannelCardTemplate}"/>

            <Border Padding="14" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Theoretical tilt from the signal amplitude" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="S1"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TheoreticalTiltS1Text, Mode=OneWay}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="S2"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TheoreticalTiltS2Text, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Noise of the raw batch readings (API 3.2) -->
            <Border Padding="14" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Noise" FontSize="18" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="Restart window"
                                Command="{x:Bind ViewModel.RestartNoiseWindowCommand}"
                                IsEnabled="{x:Bind ViewModel.NoiseSupported, Mode=OneWay}"
                                ToolTipService.ToolTip="Start a fresh 10 s window, to read the noise since you touched the table. The quiet floors are kept."/>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" LineHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Noise of the raw, unsmoothed batch readings (about 40 per second) over the last 10 s, in µm/m: the standard deviation (σ) and the peak-to-peak spread. Quadrature is the part of the signal that is not tilt, so it shows sensor noise independent of real movement. A reading is flagged doubtful when its step ÷ floor exceeds 2.45×."/>

                    <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.NoiseNote, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{x:Bind ViewModel.NoiseNoteVisible, Mode=OneWay, Converter={StaticResource Vis}}"/>

                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.HasNoiseSample, Mode=OneWay, Converter={StaticResource Vis}}">
                        <TextBlock Text="{x:Bind ViewModel.NoiseWindowText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.NoiseWindowFraction, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.NoiseValid, Mode=OneWay, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    </StackPanel>

                    <StackPanel Spacing="2"
                                Visibility="{x:Bind ViewModel.ShowNoiseTable, Mode=OneWay, Converter={StaticResource Vis}}">
                        <Grid ColumnSpacing="8" ColumnDefinitions="1.5*,*,*,*,1.2*" Opacity="0.7">
                            <TextBlock Grid.Column="0" Text="SENSOR" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="1" Text="σ" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="2" Text="PEAK–PEAK" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="3" Text="QUADRATURE σ" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="4" Text="STEP ÷ FLOOR" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NoiseRows}"
                                      ItemTemplate="{StaticResource NoiseRowTemplate}"/>
                        <TextBlock Text="{x:Bind ViewModel.NoiseFloorsText, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
