<Page
    x:Class="LevelApp.App.Views.MeasurementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LevelApp.App.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Header: progress bar ──────────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="24,16,24,12"
              ColumnDefinitions="Auto,*,Auto">

            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <ProgressBar Width="240"
                             Minimum="0" Maximum="100"
                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                             VerticalAlignment="Center"/>
                <Button Content="Cancel measurement"
                        Command="{x:Bind ViewModel.CancelMeasurementCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ── Connection status InfoBar ─────────────────────────────────── -->
        <InfoBar Grid.Row="1"
                 x:Name="ConnectionStatusBar"
                 IsOpen="{x:Bind ViewModel.ShowConnectionWarning, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.ConnectionSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.ConnectionStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Margin="24,0,24,0">
            <InfoBar.ActionButton>
                <Button x:Uid="Instrument_Retry"
                        Command="{x:Bind ViewModel.InstrumentReading.RetryCommand}"
                        Visibility="{x:Bind ViewModel.ShowRetry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ── Main content ───────────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,320"
              Padding="24,0,24,24"
              ColumnSpacing="24">

            <!-- Left: grid map -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20">
                <ScrollViewer HorizontalScrollMode="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="GridCanvas"/>
                </ScrollViewer>
            </Border>

            <!-- Right: orientation + instruction + reading -->
            <StackPanel Grid.Column="1"
                        Spacing="16">

                <!-- Orientation badge -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="56" Height="56"
                            CornerRadius="28"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="{x:Bind ViewModel.OrientationArrow, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>

                    <!-- Orientation label with ⓘ flyout -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock x:Uid="Measurement_OrientationLabel"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Style="{StaticResource HelpButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MaxWidth="340" Spacing="8">
                                        <TextBlock x:Uid="Orientation_Help_Title" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        <TextBlock x:Uid="Orientation_Help_Body" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Instruction card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock Text="{x:Bind ViewModel.CurrentInstructionText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}"/>
                </Border>

                <!-- Last accepted reading, with a way back to repeat it -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="{x:Bind ViewModel.HasLastReading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Last reading"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.LastReadingText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="&#x2190; Go back"
                                Command="{x:Bind ViewModel.GoBackCommand}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Instrument: live value, channel, take reading, zero (hidden for manual entry) -->
                <controls:InstrumentReadingPanel ViewModel="{x:Bind ViewModel.InstrumentReading}"/>

                <!-- Reading entry (label replaced from Header attribute) -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Uid="Measurement_ReadingLabel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource HelpButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MaxWidth="340" Spacing="8">
                                        <TextBlock x:Uid="Reading_Help_Title" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        <TextBlock x:Uid="ReadingMicro_Help_Body" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <NumberBox PlaceholderText="Enter instrument reading"
                               Value="{x:Bind ViewModel.Reading, Mode=TwoWay}"
                               SmallChange="1"
                               LargeChange="10"
                               SpinButtonPlacementMode="Compact"
                               IsEnabled="{x:Bind ViewModel.IsInputEnabled, Mode=OneWay}"/>
                </StackPanel>

                <!-- Accept button -->
                <Button x:Uid="Measurement_AcceptButton"
                        Command="{x:Bind ViewModel.AcceptReadingCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.IsInputEnabled, Mode=OneWay}"/>

            </StackPanel>
        </Grid>

        <!-- ── Calculating overlay ────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Visibility="{x:Bind ViewModel.CalculatingVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Margin="24,0,24,24"
                Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="24" Height="24"/>
                <TextBlock x:Uid="Measurement_Calculating"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>
        </Border>

    </Grid>

</Page>
