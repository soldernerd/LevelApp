<UserControl
    x:Class="LevelApp.App.Views.InstrumentPluginTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LevelApp.App.ViewModels">

    <!-- Devices and actions sit in a collapsible header; the plugin's own view (for the
         Leveltronic: live screen, scope, diagnostics, settings...) gets the rest of the page. -->
    <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="0,12,0,0">

        <Expander x:Name="DevicesExpander"
                  Grid.Row="0"
                  Header="Devices and actions"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

                <!-- ── Section: Known Devices ─────────────────────────────────────── -->
                <StackPanel Spacing="12">

                <TextBlock Text="Known Devices"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <!-- Device list — shown only when there are known devices -->
                <ItemsControl x:Name="DeviceList"
                              ItemsSource="{x:Bind ViewModel.KnownDevices, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KnownDeviceViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="12,8"
                                    Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind DisplayName}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            CornerRadius="2"
                                            Padding="4,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TransportLabel}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Give this device a name"
                                            Click="OnRenameDeviceClicked">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="3"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Forget this device"
                                            Click="OnForgetDeviceClicked">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                    <!-- Empty state -->
                <TextBlock x:Name="NoDevicesText"
                           Text="No devices registered."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Visibility="Collapsed"/>

                    <!-- Add Device button — hidden for always-connected plugins -->
                <Button x:Name="AddDeviceButton"
                        Content="+ Add Device"
                        Click="OnAddDeviceClicked"
                        Visibility="Collapsed"/>

            </StackPanel>

                <!-- ── Section: Actions ───────────────────────────────────────────── -->
                <StackPanel Spacing="8">

                <TextBlock Text="Actions"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Button x:Name="CalibrationButton"
                            Content="Calibration"
                            Click="OnCalibrationClicked"
                            Visibility="Collapsed"/>

                    <Button x:Name="FirmwareUpdateButton"
                            Content="Firmware Update"
                            Click="OnFirmwareUpdateClicked"
                            Visibility="Collapsed"/>

                </StackPanel>

            </StackPanel>


                </StackPanel>
            </ScrollViewer>
        </Expander>

        <!-- ── Plugin-specific view (if any) ─────────────────────────────── -->
        <ContentPresenter x:Name="PluginSpecificContent"
                          Grid.Row="1"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Visibility="Collapsed"/>

    </Grid>

</UserControl>
