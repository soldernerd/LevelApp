<UserControl
    x:Class="LevelApp.App.Views.InstrumentPluginTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LevelApp.App.ViewModels">

    <!-- Top: all known devices, each with its own Connect button, and Add Device.
         Below: what belongs to the connected device (actions, live screen, settings...),
         shown only while a device is connected. -->
    <!-- The page scrolls as a whole: on a small screen the device list, the actions and the tab strip leave
         too little height for the tabs below, and nothing could be scrolled to. The grid is at least as
         tall as the window (so the plugin surface still fills it) and the surface at least 560 tall. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnPageScrollSizeChanged">
    <Grid x:Name="PageGrid" RowDefinitions="Auto,Auto,*" RowSpacing="12" Padding="0,12,12,12">

        <!-- Devices -->
        <StackPanel Grid.Row="0" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Devices"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>

            <ItemsControl x:Name="DeviceList"
                          ItemsSource="{x:Bind ViewModel.KnownDevices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KnownDeviceViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,0,0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind TechnicalLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Visibility="{x:Bind TechnicalVisibility}"/>
                                    <TextBlock Text="connected"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Visibility="{x:Bind ConnectedVisibility, Mode=OneWay}"/>
                                    <ProgressRing Width="16" Height="16" IsActive="True"
                                                  Visibility="{x:Bind BusyVisibility, Mode=OneWay}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        CornerRadius="2"
                                        Padding="4,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TransportLabel}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <Button Grid.Column="2"
                                        Content="{x:Bind ConnectButtonText, Mode=OneWay}"
                                        IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                        Visibility="{x:Bind ConnectVisibility, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        MinWidth="96"
                                        Click="OnConnectDeviceClicked"/>
                                <Button Grid.Column="3"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Give this device a name"
                                        Click="OnRenameDeviceClicked">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="4"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Forget this device"
                                        Click="OnForgetDeviceClicked">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoDevicesText"
                       Text="No devices registered."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Visibility="Collapsed"/>

            <InfoBar x:Name="ConnectError"
                     Severity="Error"
                     IsClosable="True"
                     IsOpen="False"/>

            <!-- Add Device button: hidden for always-connected plugins (manual transport) -->
            <Button x:Name="AddDeviceButton"
                    Content="+ Add Device"
                    Click="OnAddDeviceClicked"
                    Visibility="Collapsed"/>
        </StackPanel>

        <!-- Actions of the connected device -->
        <StackPanel x:Name="ConnectedActions"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
            <TextBlock x:Name="ConnectedTitle"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <Button x:Name="CalibrationButton"
                    Content="Calibration"
                    Click="OnCalibrationClicked"
                    Visibility="Collapsed"/>
            <Button x:Name="FirmwareUpdateButton"
                    Content="Firmware Update"
                    Click="OnFirmwareUpdateClicked"
                    Visibility="Collapsed"/>
        </StackPanel>

        <!-- The plugin surface for the connected device (and the calibration view, one at a time) -->
        <Grid x:Name="PluginHost" Grid.Row="2" Visibility="Collapsed" MinHeight="560">
            <ContentPresenter x:Name="PluginSpecificContent"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"/>
            <ContentPresenter x:Name="CalibrationContent"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Visibility="Collapsed"/>
        </Grid>

    </Grid>
    </ScrollViewer>
</UserControl>
