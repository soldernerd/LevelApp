<UserControl
    x:Class="LevelApp.App.Controls.InstrumentReadingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The instrument half of the reading entry: live value, channel, settled measurement, zero. -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Padding="16"
            Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel Spacing="10">

            <TextBlock x:Uid="Instrument_Header"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <ComboBox x:Uid="Instrument_Channel"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"/>

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.LiveText, Mode=OneWay}"
                           Style="{StaticResource MetricValueStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        x:Uid="Instrument_TakeReading"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.TakeReadingCommand}"
                        IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"/>
                <Button Grid.Column="1"
                        x:Uid="Instrument_Cancel"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

            <ProgressBar Minimum="0" Maximum="100"
                         Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <StackPanel Spacing="4"
                        Visibility="{x:Bind ViewModel.SupportsZero, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Instrument_ZeroDiff"
                            Command="{x:Bind ViewModel.ZeroCommand}"
                            IsEnabled="{x:Bind ViewModel.CanZero, Mode=OneWay}"/>
                    <HyperlinkButton x:Uid="Instrument_ClearZero"
                                     Command="{x:Bind ViewModel.ClearZeroCommand}"
                                     Visibility="{x:Bind ViewModel.IsZeroed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ZeroText, Mode=OneWay}"
                           Style="{StaticResource HelperTextStyle}"
                           Visibility="{x:Bind ViewModel.IsZeroed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <InfoBar Severity="Warning"
                     IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"/>

        </StackPanel>
    </Border>
</UserControl>
