<Window
    x:Class="LevelApp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Menu bar ──────────────────────────────────────────────────────── -->
        <MenuBar Grid.Row="0">

            <MenuBarItem x:Uid="Menu_File">
                <MenuFlyoutItem x:Uid="Menu_File_NewProject"
                                Command="{x:Bind ViewModel.NewProjectCommand}"/>
                <MenuFlyoutItem x:Uid="Menu_File_OpenProject"
                                Command="{x:Bind ViewModel.OpenProjectCommand}"/>
                <MenuFlyoutItem x:Uid="Menu_File_SaveProject"
                                Command="{x:Bind ViewModel.SaveProjectCommand}"/>
                <MenuFlyoutItem x:Uid="Menu_File_SaveProjectAs"
                                Command="{x:Bind ViewModel.SaveProjectAsCommand}"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="Menu_File_Exit"
                                Command="{x:Bind ViewModel.ExitCommand}"/>
            </MenuBarItem>

            <MenuBarItem x:Uid="Menu_Edit">
                <MenuFlyoutItem x:Uid="Menu_Edit_Preferences"
                                Click="OnPreferencesClicked"/>
            </MenuBarItem>

            <MenuBarItem x:Uid="Menu_Instruments">
                <MenuFlyoutItem x:Uid="Menu_Instruments_Manage"
                                Click="OnInstrumentsClicked"/>
            </MenuBarItem>

            <MenuBarItem x:Uid="Menu_Help">
                <MenuFlyoutItem x:Uid="Menu_Help_About"
                                Click="OnAboutClicked"/>
            </MenuBarItem>

        </MenuBar>

        <!-- Shell content: the theme service targets this grid so both tabs follow the theme. -->
        <Grid x:Name="ShellContent" Grid.Row="1" RowDefinitions="Auto,*">

            <!-- ── Top-level tabs ────────────────────────────────────────────── -->
            <SelectorBar x:Name="MainTabs"
                         Grid.Row="0"
                         Margin="24,8,24,0"
                         SelectionChanged="OnMainTabChanged">
                <SelectorBarItem x:Name="ProjectTabItem" Text="Project" IsSelected="True"/>
                <SelectorBarItem x:Name="InstrumentsTabItem" Text="Instruments"/>
            </SelectorBar>

            <!-- ── Navigation hosts: one Frame per tab so switching never loses state ── -->
            <Grid Grid.Row="1">
                <Frame x:Name="RootFrame"/>
                <Frame x:Name="InstrumentsFrame" Visibility="Collapsed"/>
            </Grid>
        </Grid>

    </Grid>

</Window>
